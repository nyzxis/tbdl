# Server Port (default 5000)
PORT=5000

# Your TeraBox 'ndus' cookie
# Retrieve this from your browser's Developer Tools -> Application -> Cookies -> terabox.com -> 'ndus'
TERABOX_COOKIE_NDUS=your_ndus_cookie_here

# Alternatively, paste full cookie json:
# COOKIE_JSON={"ndus":"your_ndus_cookie_here"}
